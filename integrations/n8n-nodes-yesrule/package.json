    "nodes": ["dist/nodes/Yesrule/Yesrule.node.js"]
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
