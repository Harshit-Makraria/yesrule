{
  "name": "yesrule-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "(cd ../engine && uv run python -c \"import json;from yesrule.api import create_app;print(json.dumps(create_app('sqlite://').openapi()))\") > ${TMPDIR:-/tmp}/yesrule-openapi.json && openapi-typescript ${TMPDIR:-/tmp}/yesrule-openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
